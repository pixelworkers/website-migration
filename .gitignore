# Never commit secrets or migration artifacts.
.env
.env.*
*.env
credentials*
secrets*
wp-config.php

# Database dumps — these contain the whole site, users included.
*.sql
*.sql.gz

# Backups and transferred payloads produced by the scripts.
backups/
*.tar
*.tar.gz
*.sha256
paths.txt

# Script output / reports
out/
out-*/
*.report.json
inventory.json
inventory.csv
parity-report.*
link-report.*

# Redirect maps generated locally
_redirects
Caddyfile.redirects
redirects.nginx.conf
redirects.next.js

# User-supplied migration inputs
mapping.csv

# Node
node_modules/
npm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
